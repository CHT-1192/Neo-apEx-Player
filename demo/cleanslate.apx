    <Pass>
      <Name>blurpass</Name>
      <Code>SamplerState sm:register(s1);
Texture2D Textur:register(t0);

cbuffer b : register(b0)
{
	float t,aspect;
}

cbuffer c : register(b1)
{
	float blursize,power;
}

float4 dof(float2 t)
{
	float4 color=0;
	float totweight=0;
	
	for (int x=0; x&lt;3; x++)
	for (int y=0; y&lt;3; y++)
	{
		float2 off=float2(x,y)-1;
		float2 coord=t+off*blursize*0.1*float2(1/aspect,1);
		color+=Textur.SampleLevel(sm,coord,0);
		totweight+=1;
	}
	
	return color/totweight;
}


float4 p( float2 t:TEXCOORD0 ) : SV_TARGET0
{
 return dof(t);//Textur.Sample(sm,t.xy);
}</Code>
      <Minifiable>1</Minifiable>
      <Parameter>
        <GUID>1595E4A74173C2C7772649ADB291B59E</GUID>
        <Name>Input</Name>
      
        <Scope>0</Scope>
      
        <Type>7</Type>
      
        <TextureGUID>9DE2A20DCA6371A7D7731C30E7A870A1</TextureGUID>
      </Parameter>
    
      <Parameter>
        <GUID>1EF8FF0EB09EC0D75AB4C09B15763CAF</GUID>
        <Name>Output</Name>
      
        <Scope>0</Scope>
      
        <Type>23</Type>
      
        <TextureGUID>290A7AC85C535BCB4E3FA01128C3433B</TextureGUID>
      </Parameter>
