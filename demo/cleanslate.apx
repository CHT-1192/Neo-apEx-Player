      <Parameter>
        <GUID>9149950C687156C31BB2B76F72864A6D</GUID>
        <Name>Shadow Scaled X offset</Name>
      
        <Scope>2</Scope>
      
        <Type>0</Type>
      
        <DefaultValue>AAAAAAAAAAAAAAAAAAAAAA==</DefaultValue>
